# Contractile task shortcuts; run from the repository root:
#   just -f .machine_readable/contractiles/Justfile <recipe>

set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list --unsorted

# Pinned DEED/K9 conformance, Nickel runner checks, and coordination guard.
machine-readable-check:
    @bash "{{justfile_directory()}}/../../scripts/machine_readable_check.sh"

# Execute the K9 Must component's host-side repository probes.
must-check:
    @bash "{{justfile_directory()}}/../../scripts/must_check.sh"

# Run offline migration and coordination regression tests.
fixture-tests:
    @bash "{{justfile_directory()}}/../../tests/coordination_k9_check_test.sh"
    @bash "{{justfile_directory()}}/../../tests/machine_readable_migration_test.sh"

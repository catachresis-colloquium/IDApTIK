{
  pedigree = {
    schema_version = "1.0.0",
    component_type = "contractile:must",
    contractile_verb = "must",
    semantics = "Blocking repository invariants with explicit, locally runnable probes.",
    tier = 'Kennel,
    authority = 'blocking,
    security = {
      leash = 'Kennel,
      trust_level = "declaration-only",
      allow_network = false,
      allow_filesystem_write = false,
      allow_subprocess = false,
      capabilities = [],
    },
    metadata = {
      name = "idaptik-must",
      version = "1.0.0",
      description = "Critical IDApTIK repository probes; critical failures block CI.",
      author = "IDApTIK contributors",
      paired_runner = "must.ncl",
    },
    side_effects = [],
  },
  declaration = {
    schema_version = "1.0.0",
    verb = "must",
    authority = 'blocking,
    source_of_truth = "IDApTIK_chora.deed",
    runner = "scripts/must_check.sh",
    clauses = [
      { id = "license-present", severity = "critical", description = "The repository license file exists.", probe = "license-present", scope = "repository root", evidence = "LICENSE" },
      { id = "license-texts-present", severity = "critical", description = "Code, documentation, and workflow license texts are present.", probe = "license-texts-present", scope = "LICENSES/", evidence = "LICENSES/AGPL-3.0-or-later.txt and LICENSES/CC-BY-SA-4.0.txt" },
      { id = "readme-present", severity = "critical", description = "The human-facing project guide exists.", probe = "readme-present", scope = "repository root", evidence = "README.md" },
      { id = "ai-front-doors-present", severity = "critical", description = "The project deed, startup pointer, and root coordination protocol exist.", probe = "ai-front-doors-present", scope = "repository root", evidence = "0-AI-MANIFEST.deed, IDApTIK_chora.deed, and coordination.k9" },
      { id = "governance-docs", severity = "critical", description = "Governance, maintainer, conduct, and ownership records exist.", probe = "governance-docs", scope = "repository governance", evidence = "GOVERNANCE.md, .github/MAINTAINERS, CODE_OF_CONDUCT.md, and .github/CODEOWNERS" },
      { id = "mise-pins-present", severity = "critical", description = "mise pins the Zig and Elixir toolchains.", probe = "mise-pins-present", scope = "toolchain configuration", evidence = "mise.toml" },
      { id = "rust-toolchain-pinned", severity = "critical", description = "The Rust toolchain is pinned to the project's declared version.", probe = "rust-toolchain-pinned", scope = "toolchain configuration", evidence = "rust-toolchain.toml and IDApTIK_chora.deed" },
      { id = "engine-license-agpl", severity = "critical", description = "The Cargo workspace declares AGPL-3.0-or-later for engine code.", probe = "engine-license-agpl", scope = "Cargo workspace", evidence = "Cargo.toml" },
      { id = "crates-workspace", severity = "critical", description = "The live kernel, core, FFI, TUI, network, Evil Weevil, and Bevy crates are present.", probe = "crates-workspace", scope = "crates/", evidence = "crates/idaptik-kernel, idaptik-core, idaptik-ffi, idaptik-tui, idaptik-net, idaptik-evil-weevil, and idaptik-bevy" },
      { id = "server-and-config", severity = "critical", description = "The Nickel configuration tree exists; relay runtime remains external.", probe = "server-and-config", scope = "config/", evidence = "config/ and docs/adr/0006-gossamer-host-and-burble-transport.md" },
      { id = "adr-records", severity = "warning", description = "The selected architecture decision records exist.", probe = "adr-records", scope = "docs/adr/", evidence = "ADR-0001, ADR-0007, ADR-0008, and ADR-0015" },
      { id = "rust-formatted", severity = "critical", description = "The Rust workspace passes the pinned rustfmt check.", probe = "rust-formatted", scope = "Rust workspace", evidence = "cargo fmt --all -- --check" },
      { id = "no-authoring-dependency", severity = "critical", description = "The game runtime does not link the modding studio or another game.", probe = "no-authoring-dependency", scope = "Cargo manifests", evidence = "Cargo.toml and crates/*/Cargo.toml" },
      { id = "cac-kernel-is-fixed-point", severity = "critical", description = "The VSM supervisor and evidence ledger contain no floating-point values.", probe = "cac-kernel-is-fixed-point", scope = "crates/idaptik-core/src/scenario/vsm.rs", evidence = "fixed-point contract" },
      { id = "package-contract-published", severity = "critical", description = "The versioned package contract, schema, and scenario fixture exist.", probe = "package-contract-published", scope = "contracts/idaptik/v1/", evidence = "contract.json, package.schema.json, and ghost-lobby-scenario.json" },
      { id = "machine-readable-dir", severity = "critical", description = "The canonical K9 contractile directory exists.", probe = "machine-readable-dir", scope = ".machine_readable/", evidence = ".machine_readable/contractiles/" },
      { id = "machine-readable-layout", severity = "critical", description = "Only the prescribed DEED, K9, runner, and coordination files remain active.", probe = "machine-readable-layout", scope = "repository metadata", evidence = "tests/machine_readable_migration_test.sh" },
      { id = "contractiles-present", severity = "critical", description = "All six K9 contractile components have paired Nickel runner descriptors.", probe = "contractiles-present", scope = ".machine_readable/contractiles/", evidence = "adjust, bust, dust, intend, must, and trust component/runner pairs" },
      { id = "ffi-language-claims-honest", severity = "critical", description = "Zig and Idris2 implementation claims match the source tree and CI wiring.", probe = "ffi-language-claims-honest", scope = "source tree and deed", evidence = "IDApTIK_chora.deed and abi_model_check.sh" },
      { id = "vendor-patch-gated", severity = "critical", description = "The temporary bevy_winit patch remains connected to parity and fixture gates.", probe = "vendor-patch-gated", scope = "vendor/bevy_winit", evidence = "scripts/vendor_bevy_winit_check.sh and tests/vendor_winit_check_test.sh" },
      { id = "deployment-contract-recorded", severity = "critical", description = "The deployment-axis and state-placement model is present and documented.", probe = "deployment-contract-recorded", scope = "network architecture", evidence = "crates/idaptik-net/src/deployment.rs and ADR-0015" },
      { id = "deployment-mode-cross-product", severity = "critical", description = "Peer-to-peer, hosted, and federated profiles accept GSA absent or present.", probe = "deployment-mode-cross-product", scope = "deployment model tests", evidence = "all_three_topologies_allow_gsa_present_or_absent_without_merging_axes" },
      { id = "state-class-contract-present", severity = "critical", description = "Every state class has an explicit topology-aware owner and recovery contract.", probe = "state-class-contract-present", scope = "deployment state model", evidence = "STATE_CLASSES and every_state_class_has_explicit_owner_storage_cache_consistency_partition_and_recovery" },
      { id = "snif-boundary-recorded", severity = "critical", description = "SNIF guests are bounded to compute and buffers; I/O remains host-side.", probe = "snif-boundary-recorded", scope = "SNIF integration boundary", evidence = "ADR-0015 and coordination.k9" },
      { id = "coordination-k9-v1-2", severity = "critical", description = "The root coordination protocol passes its current-version structural guard.", probe = "coordination-k9-v1-2", scope = "coordination.k9", evidence = "scripts/coordination_k9_check.sh" },
      { id = "legacy-layout-retired", severity = "critical", description = "No legacy A2ML files, wrapper manifest, or obsolete readers remain active.", probe = "legacy-layout-retired", scope = "repository metadata", evidence = "tests/machine_readable_migration_test.sh" },
      { id = "validation-ci-wired", severity = "critical", description = "CI validates DEED and K9 with the pinned standards tools.", probe = "validation-ci-wired", scope = ".github/workflows/ci.yml", evidence = "machine-readable-conformance job invoking scripts/machine_readable_check.sh" },
    ],
  },
}

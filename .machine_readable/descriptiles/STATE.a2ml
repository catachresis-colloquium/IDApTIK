# SPDX-License-Identifier: AGPL-3.0-or-later
# STATE.a2ml — current IDApTIK project state

[metadata]
project = "IDApTIK"
version = "0.1.0"
type = "game"
last-updated = "2026-09-20"
branch = "main"
build-status = "Envelope vertical slice implemented; player-facing GUI incomplete"
test-status = "Rust core/TUI/FFI/net, Bevy frontend, Nickel contracts, and the Burble-backed two-seat loopback are CI-gated; the cross-repository UMS round trip is not currently CI-gated"

[project-context]
description = "Asymmetric two-player infiltration game. One player infiltrates a physical space; the other hacks a grounded network simulation."
subtitle = "Invisible Door: Action Point Trauma Inc. Kickers"
truth-language = "rust"
session-language = "elixir"
ffi-language = "zig"
ffi-status = "present: crates/idaptik-ffi/zig-adapter — the Zig adapter consumes the exported C ABI, with a conformance suite checked against the Idris2 ABI model and a fuzz layer, gated by the abi-conformance workflow; the residual serde-wire work is tracked in issue #103"
abi-model-language = "idris2"
abi-model-status = "present: crates/idaptik-ffi/abi — a total, typechecked model of the C ABI (ownership, wire shapes, determinism, snapshot invariants) gated by scripts/abi_model_check.sh; the serde-wire conformance suite is still pending, tracked in issue #103"
config-language = "nickel"
selected-renderer = "bevy"
planned-host = "gossamer"
session-transport = "burble"
runtime-dependencies = ["bevy", "bandit", "phoenix_channels", "nickel"]

[roadmap]
phases = "Envelope > Wheel > Skateboard > Bicycle > Chassis > Motorcycle > Computer Game"
current-phase = "Envelope"
phase-goal = "Turn the proven Ghost Lobby/TUI/netplay slice into a coherent player-facing Bevy prototype with first art and documented mechanics."

[component-status]
core = { status = "live", notes = "Deterministic event-sourced Ghost Lobby, building runtime, grounded network, actors, snapshots, package loading, and replay." }
net = { status = "live", notes = "Two-seat delay lockstep, pacing, pause, peer loss, digest checks, snapshot resync, and interactive client." }
ffi = { status = "partial", notes = "The Rust-exported C ABI drives the real Ghost Lobby simulation with JSON command/event and snapshot parity; the Idris2 ABI model exists (crates/idaptik-ffi/abi, gated in CI); the Zig adapter now exists too (crates/idaptik-ffi/zig-adapter) with conformance and fuzz suites; the Idris2 proof obligations and the serde-wire conformance suite remain, tracked in issue #103." }
tui = { status = "live", notes = "Playable reference frontend plus headless, replay, and export verification." }
bevy-frontend = { status = "selected-partial", notes = "Working renderer, HUD, keymap, interpolation, and parity tests; full player-facing shell and visual validation remain." }
burble-relay = { status = "external-live", notes = "The relay lives in sibling metadatastician/burble. IDApTIK pins a known-compatible revision in CI and gates role routing, de-duplication, determinism, peer loss, lockstep, and snapshot resync through its game lane." }
config = { status = "live", notes = "Nickel schemas, positive exports, semantic Rust round-trip, and negative fixtures." }
ums-package = { status = "live-v1", notes = "IDApTIK-owned v1 package syntax, loader, semantic validation, deterministic execution, snapshot/restore, and replay." }
ums-roundtrip = { status = "tested", notes = "Every UMS ADR-0014 clause met as of 2026-07-28. RoundTripResult.accepted exports the loader's parsed view of the authored envelope; UMS diffs it against the profile source and fails on any difference. Deliberately excludes `scenario`, which the compiler copies from this repository's own fixture verbatim -- comparing it would be a tautology." }
cac-trace = { status = "live-fixture", notes = "Six-stage CacTrace runs in the package round trip and is gated. Six GuardTraceStage variants map 1:1 onto Enaction's Domain enum for ONE scenario; whether that is a result or a coincidence is unvalidated." }
evidence-ledger = { status = "in-repo-by-decision", notes = "Dempster-Shafer evidence ledger and VSM supervisor live in crates/idaptik-core and stay there until the Enaction extraction trigger fires. See ADR-0010." }
moletaire = { status = "tested-seam", notes = "Deterministic companion module exists but is not wired into GhostLobbySim." }

[settled-decisions]
items = [
  { item = "Bevy is the selected graphical frontend; Fyrox is retired", ref = "ADR-0008" },
  { item = "IDApTIK owns the versioned UMS package boundary", ref = "ADR-0007" },
  { item = "Elixir session life is supplied by the external Burble game lane; IDApTIK owns deterministic gameplay and the client contract", ref = "ADR-0006" },
  { item = "Enaction Engine is the runtime kernel; UMS is the authoring studio; a shipped game runs with neither UMS source nor binaries present", ref = "enaction ADR-0013" },
  { item = "IDApTIK may depend one-way on enaction-* under three stated conditions; never on idaptik-ums or slavia-core", ref = "ADR-0009" },
  { item = "The evidence ledger and VSM supervisor stay in idaptik-core until a three-part extraction trigger fires", ref = "ADR-0010" },
  { item = "Cognitive-model work is documented in the open; the private-repository split is withdrawn", ref = "ADR-0011" },
  { item = "Cognition is discrete and event-gated, affect continuous and per-tick; they join only at an event-sourced ledger, and affect buys attention rather than belief", ref = "enaction ADR-0014" },
  { item = "Mass (fixed point, 1/10000) is the kernel confidence type; a relational solution count is not a confidence and has no numeric conversion", ref = "enaction ADR-0016" },
]

[open-decisions]
remaining = [
  { item = "Persistence and save-compatibility policy", resolve-by = "post-Envelope" },
  { item = "Long-term Rust/Elixir wire encoding beyond the current JSON contract", resolve-by = "post-Envelope", ref = "ADR-0005" },
  { item = "Canonical era versus switchable style axis", resolve-by = "before substantial asset production" },
  { item = "Public relay, matchmaking, and authoritative-host policy", resolve-by = "before public playtesting" },
  { item = "Canonical proposition language: whether a Dempster-Shafer focal set can contain a non-ground proposition. Blocks a single shared ESM crate", resolve-by = "before any kernel extraction" },
  { item = "Theory-of-mind depth and resource accounting. Any cap must be counted in deterministic units -- inferences or unifications, never milliseconds -- or byte-parity breaks", resolve-by = "before nested belief ships" },
  { item = "Whether affect is state or an annotation on events. The shared contract currently permits only the latter", resolve-by = "before affect enters Rust" },
  { item = "What verification means in the conative path, and the rule that a veto must be an event rather than a silent substitution", resolve-by = "before an action gate ships" },
]

[route-to-mvp]
remaining = [
  { item = "Build the Bevy product shell: launch, session/seat choice, Ghost Lobby play, debrief, and restart", priority = "critical" },
  { item = "Validate the Bevy frontend in a real window and establish performance/accessibility baselines", priority = "critical" },
  { item = "Add a first intentional art, UI, and sound pass", priority = "high" },
  { item = "Write the era ledger, initial region trope definitions, and story-bible skeleton", priority = "high" },
  { item = "Define persistence/versioning using the existing snapshot and event-log substrate", priority = "medium" },
]

[cross-repository-reconciliation]
coordination-id = "ums-idaptik-slavia-enaction-2026-07-25"
status = "settled and enforced; architecture PRs #61/#63 landed 2026-07-27, round-trip comparison #65 landed 2026-07-28"
role = "Authoritative owner of IDApTIK package syntax, gameplay vocabulary, semantic validation, migrations, snapshots, package loading, and runtime execution."
settled = [
  "IDApTIK does not depend on the UMS user interface or UMS Core",
  "UMS consumes the IDApTIK-owned versioned contract",
  "IDApTIK does not import Chronicles of Slavia profile types",
  "Enaction adoption requires fresh game-host evidence",
  "Boundaries are enforced by Mustfile invariants that fail with no sibling repository present, not by prose",
]

[verification-notes]
# Recorded because each was a check that reported success without checking.
items = [
  { note = "cargo fmt is gated in its own fast CI job as well as inside test-ghost; a formatting fault previously cost a full test-and-clippy cycle to surface" },
  { note = "cac-kernel-is-fixed-point pins scenario/vsm.rs only. The rest of scenario/ uses f64 for continuous world quantities under ADR-0004; actor/belief.rs, trace.rs and agents.rs still hold floats and must convert before feeding the ledger" },
  { note = "The round-trip gate fails loudly, not silently, when run against a game too old to export RoundTripResult.accepted" },
]

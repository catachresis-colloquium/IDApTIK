(repo-deed
  :schema-version "1.0.0"
  :canonical-name "idaptik-weevil-guard-brain"
  :repo-uuid #u5"gv-clade-index:github.com/catachresis-colloquium/IDApTIK"
  (identity :owner "catachresis-colloquium" :primary-forge github)
  (front-doors :human "docs/standards/deed/idaptik-weevil-guard-brain-conformance.adoc" :agent "0-AI-MANIFEST.deed")
  (routing
    :deed "docs/standards/deed/"
    :adapter "crates/idaptik-weevil/"
    :game "crates/idaptik-core/src/scenario/guard_brain.rs")
  (conformance
    (grammar :normative "1-formats/deed/spec/abnf/deed.abnf" :status "v1.2.0")
    (checked
      (clause :id "C1" :claim "The native integration uses the generated C ABI and never hand-edits generated headers")
      (clause :id "C2" :claim "The game owns truth, physics, collision, nav, guard identity and authoritative action validation")
      (clause :id "C3" :claim "The kernel owns per-agent memory and proposes intents only")
      (clause :id "C4" :claim "Memory is a bearing plus age, not a position; the host owns the last-known position")
      (clause :id "C5" :claim "Replay equality is checked only within an explicitly supported configuration")
      (clause :id "C6" :claim "The decision-cache identity folds memory, RNG and context into one digest")
      (clause :id "C7" :claim "The classic guard FSM remains selectable for comparison and rollback")
      (clause :id "C8" :claim "One controlled in-game deception records source, age and confidence against world truth")))
  (evidence
    (status :kind "partial" :reason "No Rust/Zig toolchain in the authoring sandbox; no compile or run evidence was produced there")))
